{
    "version": "2.0.0",
    "tasks" : [
        {
            "label": "Build C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "./game.cpp",
                "./libs/board/board.cpp",
                "./libs/ai/ai.cpp",
